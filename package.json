{
  "name": "tesvikler-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "local": "node --preserve-symlinks --preserve-symlinks-main ./node_modules/vite/bin/vite.js --host 127.0.0.1 --port 5173 --strictPort",
    "build": "node --preserve-symlinks --preserve-symlinks-main ./node_modules/typescript/lib/tsc.js && node --preserve-symlinks --preserve-symlinks-main ./node_modules/vite/bin/vite.js build --mode publish",
    "publish": "npm run build && node --preserve-symlinks --preserve-symlinks-main ./node_modules/vite/bin/vite.js preview --mode publish --host 0.0.0.0 --port 4173 --strictPort"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.105.4",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.14.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.15.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.6.2",
    "vite": "^5.4.10"
  }
}
